# ====================================================
# QCOS 青鹭收银系统 - 安全配置示例
# ====================================================
# 用法：复制此文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，不会进入 Git。
# 绝不要把真实密钥写入任何 Git 跟踪文件。

# Flask SECRET_KEY — 必须设置，否则系统拒绝启动
# 生成强随机密钥：python -c "import secrets;print(secrets.token_hex(32))"
QCOS_SECRET_KEY=请替换为强随机密钥

# 初始管理员密码 — 仅在首次初始化数据库（新建 qcos.db）时使用
# 已有数据库不受影响，绝不修改现有管理员密码
QCOS_ADMIN_PASSWORD=请替换为强密码

# 中仑开放平台凭证（仅启用扫码支付确认 provider=zhonglun 时需要）
QCOS_ZHONGLUN_APPKEY=
QCOS_ZHONGLUN_SECRET=
